//@version=5
// ══════════════════════════════════════════
// 賽克斯 SMC 看盤輔助指標（簡單版）
// 結構 BOS / MSS、訂單塊 OB、FVG、盤整 / PO3、
// 流動性、溢價 / 折價區、資訊面板
// 規格見 pine/SPEC.md
// ══════════════════════════════════════════
indicator("賽克斯 SMC 看盤輔助", shorttitle = "SAIX SMC", overlay = true, max_bars_back = 1000, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ══════════════════════════════════════════
// 輸入設定
// ══════════════════════════════════════════
GRP_MS = "① 結構 BOS / MSS"
swingMode  = input.string("收盤跌破創高K棒", "高低點確認方式", options = ["收盤跌破創高K棒", "連續N根沒創新高", "回落X倍ATR"], group = GRP_MS, tooltip = "收盤跌破創高K棒：收盤跌破做出最高點那根K棒的最低價，高點才確認（低點反過來）\n連續N根沒創新高：最高點之後連續 N 根都沒有更高\n回落X倍ATR：從最高點回落超過 X 倍 ATR")
swingN     = input.int(3, "N（連續根數）", minval = 1, group = GRP_MS)
swingX     = input.float(1.0, "X（ATR 倍數）", minval = 0.1, step = 0.1, group = GRP_MS)
showStruct = input.bool(true, "顯示 BOS / MSS", group = GRP_MS)
bullCol    = input.color(#089981, "多方", group = GRP_MS, inline = "col")
bearCol    = input.color(#F23645, "空方", group = GRP_MS, inline = "col")

GRP_OB = "② 訂單塊 OB"
showOB     = input.bool(true, "顯示 OB", group = GRP_OB)
obMax      = input.int(10, "最多保留", minval = 1, maxval = 50, group = GRP_OB)
obBullCol  = input.color(color.new(#089981, 80), "多方 OB", group = GRP_OB, inline = "ob")
obBearCol  = input.color(color.new(#F23645, 80), "空方 OB", group = GRP_OB, inline = "ob")
breakerCol = input.color(color.new(#787B86, 80), "破壞塊", group = GRP_OB, inline = "ob")

GRP_FVG = "③ FVG"
showFVG    = input.bool(true, "顯示 FVG", group = GRP_FVG)
fvgMax     = input.int(10, "最多保留", minval = 1, maxval = 50, group = GRP_FVG)
fvgBullCol = input.color(color.new(#2962FF, 80), "多方 FVG", group = GRP_FVG, inline = "fvg")
fvgBearCol = input.color(color.new(#FF9800, 80), "空方 FVG", group = GRP_FVG, inline = "fvg")

GRP_CONS = "④ 盤整 / PO3"
showCons = input.bool(true, "顯示盤整框", group = GRP_CONS)
showPO3  = input.bool(true, "顯示 PO3（操縱框 / 擴張確認）", group = GRP_CONS)
eqTol    = input.float(0.3, "等高 / 等低誤差（ATR 倍數）", minval = 0.01, step = 0.05, group = GRP_CONS)
consCol  = input.color(color.new(#2962FF, 0), "盤整框", group = GRP_CONS, inline = "cc")
manipCol = input.color(color.new(#9C27B0, 0), "操縱框", group = GRP_CONS, inline = "cc")
expCol   = input.color(color.new(#FFB300, 0), "擴張確認", group = GRP_CONS, inline = "cc")

GRP_LIQ = "⑤ 流動性"
showLiq = input.bool(true, "顯示盤整上下緣流動性", group = GRP_LIQ)
liqCol  = input.color(color.new(color.gray, 0), "線色", group = GRP_LIQ)

GRP_PD = "⑥ 溢價 / 折價區"
showPD = input.bool(true, "顯示溢價 / 折價區", group = GRP_PD)

GRP_UI = "⑦ 資訊面板"
showDash = input.bool(true, "顯示資訊面板", group = GRP_UI)
dashPos  = input.string("右上", "位置", options = ["右上", "右下", "左上", "左下"], group = GRP_UI)

// ══════════════════════════════════════════
// 資料型別
// ══════════════════════════════════════════
type Zone
    box   bx
    float top
    float btm
    bool  bull
    bool  active = true

type Liq
    line  ln
    float price
    bool  isTop

// ══════════════════════════════════════════
// 工具函式
// ══════════════════════════════════════════
atr  = ta.atr(14)
atrV = nz(atr, high - low)

// (fromBar, 目前] 之間的最高價 → [價格, 位置, 那根的最低價]
maxHighSince(int fromBar) =>
    float mx = na
    int   mb = na
    float cl = na
    n = math.min(bar_index - fromBar, 500)
    if n > 0
        for i = 0 to n - 1
            if na(mx) or high[i] > mx
                mx := high[i]
                mb := bar_index - i
                cl := low[i]
    [mx, mb, cl]

// (fromBar, 目前] 之間的最低價 → [價格, 位置, 那根的最高價]
minLowSince(int fromBar) =>
    float mn = na
    int   mb = na
    float ch = na
    n = math.min(bar_index - fromBar, 500)
    if n > 0
        for i = 0 to n - 1
            if na(mn) or low[i] < mn
                mn := low[i]
                mb := bar_index - i
                ch := high[i]
    [mn, mb, ch]

drawStructure(int x1, float y, string txt, color col, bool up) =>
    if showStruct
        line.new(x1, y, bar_index, y, color = col, style = txt == "MSS" ? line.style_dashed : line.style_solid)
        label.new(math.round((x1 + bar_index) / 2), y, txt, color = color(na), textcolor = col, style = up ? label.style_label_down : label.style_label_up, size = size.small)

// 被碰到就停止延伸（框保留）
updateZones(array<Zone> zs) =>
    if zs.size() > 0
        for i = 0 to zs.size() - 1
            z = zs.get(i)
            if z.active
                box.set_right(z.bx, bar_index)
                if z.bull ? low <= z.top : high >= z.btm
                    z.active := false

// OB：碰到不算，收盤穿過整個 OB 就停，變成破壞塊
updateOBs(array<Zone> zs) =>
    if zs.size() > 0
        for i = 0 to zs.size() - 1
            z = zs.get(i)
            if z.active
                box.set_right(z.bx, bar_index)
                if z.bull ? close < z.btm : close > z.top
                    z.active := false
                    box.set_bgcolor(z.bx, breakerCol)
                    box.set_border_color(z.bx, color.new(breakerCol, 30))
                    box.set_text(z.bx, "破壞塊")
                    box.set_text_color(z.bx, color.new(breakerCol, 0))

// 從 fromBar 往回找最後一根反方向 K 棒（含 fromBar），回傳距今根數
lastOppositeCandle(int fromBar, bool wantRed) =>
    int off = na
    start = bar_index - fromBar
    for i = start to start + 50
        if wantRed ? close[i] < open[i] : close[i] > open[i]
            off := i
            break
    off

trimZones(array<Zone> zs, int maxN) =>
    while zs.size() > maxN
        box.delete(zs.shift().bx)

// ══════════════════════════════════════════
// 1. 高低點確認（結構、盤整、溢價折價共用）
// ══════════════════════════════════════════
var int   legDir    = 0     // 1 = 正在找高點, -1 = 正在找低點
var float candH     = na
var int   candHBar  = na
var float candHLow  = na    // 創高那根 K 棒的最低價
var float candL     = na
var int   candLBar  = na
var float candLHigh = na    // 創低那根 K 棒的最高價
var float lastSH    = na
var int   lastSHBar = na
var float lastSL    = na
var int   lastSLBar = na

bool newSH = false
bool newSL = false

if barstate.isfirst
    legDir   := 1
    candH    := high
    candHBar := bar_index
    candHLow := low
else if legDir == 1
    if high > candH
        candH    := high
        candHBar := bar_index
        candHLow := low
    else
        confirmH = swingMode == "收盤跌破創高K棒" ? close < candHLow : swingMode == "連續N根沒創新高" ? bar_index - candHBar >= swingN : candH - low >= swingX * atrV
        if confirmH
            newSH     := true
            lastSH    := candH
            lastSHBar := candHBar
            [mn, mb, ch] = minLowSince(candHBar)
            legDir    := -1
            candL     := mn
            candLBar  := mb
            candLHigh := ch
else
    if low < candL
        candL     := low
        candLBar  := bar_index
        candLHigh := high
    else
        confirmL = swingMode == "收盤跌破創高K棒" ? close > candLHigh : swingMode == "連續N根沒創新高" ? bar_index - candLBar >= swingN : high - candL >= swingX * atrV
        if confirmL
            newSL     := true
            lastSL    := candL
            lastSLBar := candLBar
            [mx, mb, cl] = maxHighSince(candLBar)
            legDir    := 1
            candH     := mx
            candHBar  := mb
            candHLow  := cl

// 最近 4 個高低點（給盤整判定）
var swP = array.new_float()
var swB = array.new_int()
var swT = array.new_int()   // 1 = 高點, -1 = 低點
if newSH
    swP.push(lastSH)
    swB.push(lastSHBar)
    swT.push(1)
if newSL
    swP.push(lastSL)
    swB.push(lastSLBar)
    swT.push(-1)
while swP.size() > 4
    swP.shift()
    swB.shift()
    swT.shift()

// ══════════════════════════════════════════
// 2. 結構 BOS / MSS（收盤確認）
// ══════════════════════════════════════════
var float  tgtH      = na   // 下一個要突破的高點
var int    tgtHBar   = na
var float  tgtL      = na   // 下一個要跌破的低點
var int    tgtLBar   = na
var int    trend     = 0
var float  mssLvl    = na   // 造成最近一次 BOS 的回撤低點（空頭時為反彈高點）
var int    mssBar    = na
var string lastEvent = "—"

if newSH
    tgtH    := lastSH
    tgtHBar := lastSHBar
if newSL
    tgtL    := lastSL
    tgtLBar := lastSLBar

prevTrend = trend
brokeH    = not na(tgtH) and close > tgtH
brokeL    = not na(tgtL) and close < tgtL
bullMSS   = prevTrend == -1 and not na(mssLvl) and close > mssLvl
bearMSS   = prevTrend == 1 and not na(mssLvl) and close < mssLvl
bullBOS   = not bullMSS and brokeH and prevTrend != -1
bearBOS   = not bearMSS and brokeL and prevTrend != 1

// OB：造成 BOS / MSS 的那段走勢，起漲（起跌）前最後一根反方向 K 棒
var obs             = array.new<Zone>()
var int lastBullOB  = na
var int lastBearOB  = na
updateOBs(obs)

makeOB(int off, bool bull) =>
    top = bull ? open[off] : high[off]
    btm = bull ? low[off] : open[off]
    Zone.new(box.new(bar_index - off, top, bar_index, btm, border_color = color.new(bull ? bullCol : bearCol, 50), bgcolor = bull ? obBullCol : obBearCol, text = "OB", text_color = bull ? bullCol : bearCol, text_size = size.tiny), top, btm, bull)

if bullMSS or bullBOS
    fromBar = bullMSS ? mssBar : tgtHBar
    if bullMSS
        drawStructure(mssBar, mssLvl, "MSS", bullCol, true)
    else
        drawStructure(tgtHBar, tgtH, "BOS", bullCol, true)
    [mn, mb, ch] = minLowSince(fromBar)
    trend     := 1
    mssLvl    := mn
    mssBar    := mb
    lastEvent := bullMSS ? "多方 MSS" : "多方 BOS"
    off = lastOppositeCandle(mb, true)
    if showOB and not na(off) and (na(lastBullOB) or bar_index - off != lastBullOB)
        lastBullOB := bar_index - off
        obs.push(makeOB(off, true))

if bearMSS or bearBOS
    fromBar = bearMSS ? mssBar : tgtLBar
    if bearMSS
        drawStructure(mssBar, mssLvl, "MSS", bearCol, false)
    else
        drawStructure(tgtLBar, tgtL, "BOS", bearCol, false)
    [mx, mb, cl] = maxHighSince(fromBar)
    trend     := -1
    mssLvl    := mx
    mssBar    := mb
    lastEvent := bearMSS ? "空方 MSS" : "空方 BOS"
    off = lastOppositeCandle(mb, false)
    if showOB and not na(off) and (na(lastBearOB) or bar_index - off != lastBearOB)
        lastBearOB := bar_index - off
        obs.push(makeOB(off, false))

trimZones(obs, obMax)

// 逆勢被突破的小高低點直接消耗掉，不畫
if brokeH
    tgtH := na
if brokeL
    tgtL := na

// ══════════════════════════════════════════
// 3. FVG
// ══════════════════════════════════════════
var fvgs = array.new<Zone>()

updateZones(fvgs)

if showFVG and low > high[2]
    fvgs.push(Zone.new(box.new(bar_index - 2, low, bar_index, high[2], border_color = color(na), bgcolor = fvgBullCol, text = "FVG", text_color = color.new(#2962FF, 30), text_size = size.tiny), low, high[2], true))
if showFVG and high < low[2]
    fvgs.push(Zone.new(box.new(bar_index - 2, low[2], bar_index, high, border_color = color(na), bgcolor = fvgBearCol, text = "FVG", text_color = color.new(#FF9800, 30), text_size = size.tiny), low[2], high, false))

trimZones(fvgs, fvgMax)

// ══════════════════════════════════════════
// 4. 流動性（盤整上下緣，收盤穿過才停）
// ══════════════════════════════════════════
var liqs = array.new<Liq>()

if liqs.size() > 0
    for i = liqs.size() - 1 to 0
        lq = liqs.get(i)
        line.set_x2(lq.ln, bar_index)
        if lq.isTop ? close > lq.price : close < lq.price
            liqs.remove(i)

// ══════════════════════════════════════════
// 5. 盤整 + PO3
// ══════════════════════════════════════════
var bool  consActive = false
var box   consBox    = na
var float consTop    = na
var float consBtm    = na
var int   consEndBar = na

var bool  po3Active   = false
var int   po3Dir      = 0     // 1 = 往下操縱、準備往上擴張；-1 = 反過來
var float po3A        = na    // 操縱前最後一個轉折點
var int   po3ABar     = na
var float po3Edge     = na    // 被操縱穿出的那條盤整邊緣
var int   manipStart  = na
var float manipExt    = na
var int   manipReturn = na    // 收盤回到盤整區間內的那根

// PO3：等待擴張確認
if po3Active and bar_index > manipStart
    if po3Dir == 1
        manipExt := math.min(manipExt, low)
        if na(manipReturn) and close >= po3Edge
            manipReturn := bar_index
        if close > po3A
            po3Active := false
            if showPO3
                box.new(manipStart, po3Edge, nz(manipReturn, bar_index), manipExt, border_color = manipCol, bgcolor = color.new(manipCol, 85), text = "操縱", text_color = manipCol, text_size = size.small)
                line.new(po3ABar, po3A, bar_index, po3A, color = expCol, width = 2)
                label.new(bar_index, low, "擴張", color = color(na), textcolor = expCol, style = label.style_label_up, size = size.small)
    else
        manipExt := math.max(manipExt, high)
        if na(manipReturn) and close <= po3Edge
            manipReturn := bar_index
        if close < po3A
            po3Active := false
            if showPO3
                box.new(manipStart, manipExt, nz(manipReturn, bar_index), po3Edge, border_color = manipCol, bgcolor = color.new(manipCol, 85), text = "操縱", text_color = manipCol, text_size = size.small)
                line.new(po3ABar, po3A, bar_index, po3A, color = expCol, width = 2)
                label.new(bar_index, high, "擴張", color = color(na), textcolor = expCol, style = label.style_label_down, size = size.small)

// 盤整：收盤突破就停，並開始觀察 PO3
if consActive
    if close > consTop or close < consBtm
        upBreak    = close > consTop
        consActive := false
        consEndBar := bar_index
        if not na(consBox)
            box.set_right(consBox, bar_index)
        po3Dir      := upBreak ? -1 : 1
        po3A        := upBreak ? lastSL : lastSH
        po3ABar     := upBreak ? lastSLBar : lastSHBar
        po3Edge     := upBreak ? consTop : consBtm
        po3Active   := not na(po3A)
        manipStart  := bar_index
        manipExt    := upBreak ? high : low
        manipReturn := na
    else if not na(consBox)
        box.set_right(consBox, bar_index)

// 盤整判定：最近 4 個轉折點 = 2 個等高 + 2 個等低
if (newSH or newSL) and not consActive and swP.size() == 4
    firstBar = swB.get(0)
    if na(consEndBar) or firstBar >= consEndBar
        float hA = na
        float hB = na
        float lA = na
        float lB = na
        for i = 0 to 3
            p = swP.get(i)
            if swT.get(i) == 1
                if na(hA)
                    hA := p
                else
                    hB := p
            else
                if na(lA)
                    lA := p
                else
                    lB := p
        tol = eqTol * atrV
        top = math.max(hA, hB)
        btm = math.min(lA, lB)
        if math.abs(hA - hB) <= tol and math.abs(lA - lB) <= tol and top > btm and close <= top and close >= btm
            consActive := true
            consTop    := top
            consBtm    := btm
            po3Active  := false
            consBox    := showCons ? box.new(firstBar, top, bar_index, btm, border_color = consCol, bgcolor = color.new(consCol, 92), text = "盤整", text_color = consCol, text_size = size.small, text_valign = text.align_top) : na
            if showLiq
                liqs.push(Liq.new(line.new(firstBar, top, bar_index, top, color = liqCol, style = line.style_dashed), top, true))
                liqs.push(Liq.new(line.new(firstBar, btm, bar_index, btm, color = liqCol, style = line.style_dashed), btm, false))

// ══════════════════════════════════════════
// 6. 溢價 / 折價區（最近確認的高點 ↔ 低點，只畫最新一段）
// ══════════════════════════════════════════
var box premBox = na
var box discBox = na
pdMid = (lastSH + lastSL) / 2

if showPD and barstate.islast and not na(lastSH) and not na(lastSL)
    left  = math.min(lastSHBar, lastSLBar)
    right = bar_index + 5
    if na(premBox)
        premBox := box.new(left, lastSH, right, pdMid, border_color = color(na), bgcolor = color.new(bearCol, 90), text = "溢價", text_color = color.new(bearCol, 40), text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)
        discBox := box.new(left, pdMid, right, lastSL, border_color = color(na), bgcolor = color.new(bullCol, 90), text = "折價", text_color = color.new(bullCol, 40), text_size = size.small, text_halign = text.align_right, text_valign = text.align_bottom)
    else
        box.set_lefttop(premBox, left, lastSH)
        box.set_rightbottom(premBox, right, pdMid)
        box.set_lefttop(discBox, left, pdMid)
        box.set_rightbottom(discBox, right, lastSL)

// ══════════════════════════════════════════
// 7. 資訊面板
// ══════════════════════════════════════════
tablePos = switch dashPos
    "右上" => position.top_right
    "右下" => position.bottom_right
    "左上" => position.top_left
    => position.bottom_left

var table dash = table.new(tablePos, 2, 4, bgcolor = color.new(#131722, 10), border_color = color.new(color.gray, 70), border_width = 1)

if showDash and barstate.islast
    trendTxt = trend == 1 ? "多頭 ▲" : trend == -1 ? "空頭 ▼" : "未定 —"
    trendClr = trend == 1 ? bullCol : trend == -1 ? bearCol : color.gray
    zoneTxt  = na(pdMid) ? "—" : close > pdMid ? "溢價區" : "折價區"
    zoneClr  = na(pdMid) ? color.gray : close > pdMid ? bearCol : bullCol
    table.cell(dash, 0, 0, "SAIX SMC", text_color = color.white, text_size = size.small)
    table.cell(dash, 1, 0, syminfo.ticker, text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 1, "結構", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 1, trendTxt, text_color = trendClr, text_size = size.small)
    table.cell(dash, 0, 2, "價格位置", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 2, zoneTxt, text_color = zoneClr, text_size = size.small)
    table.cell(dash, 0, 3, "最近結構", text_color = color.silver, text_size = size.small)
    table.cell(dash, 1, 3, lastEvent, text_color = color.white, text_size = size.small)
